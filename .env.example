# Public — exposed to the browser
NEXT_PUBLIC_SITE_URL=https://seallogistics.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server only — never NEXT_PUBLIC_*
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Booking/portal signing key (HMAC for tracking/portal tokens). 32+ bytes.
PORTAL_TOKEN_SECRET=

# Upstash Redis (rate limit). Free tier is fine.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CRM email destination for lead notifications
LEAD_NOTIFY_EMAIL=ops@seallogistics.com
RESEND_API_KEY=
